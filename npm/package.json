{
  "name": "@pid7/ashwa",
  "version": "0.2.6",
  "description": "Hardware accelerated routines for single substring search",
  "main": "./index.js",
  "module": "./browser.mjs",
  "types": "./index.d.ts",
  "browser": {
    "./index.js": "./browser.js",
    "./index.mjs": "./browser.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": {
        "types": "./index.d.ts",
        "import": "./browser.mjs",
        "require": "./browser.js"
      },
      "worker": {
        "types": "./index.d.ts",
        "import": "./browser.mjs",
        "require": "./browser.js"
      },
      "node": {
        "types": "./index.d.ts",
        "import": "./index.mjs",
        "require": "./index.js"
      },
      "import": "./browser.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./browser": {
      "types": "./index.d.ts",
      "import": "./browser.mjs",
      "require": "./browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "browser.js",
    "browser.mjs",
    "index.d.ts",
    "native/index.js",
    "native/index.d.ts",
    "native/*.node",
    "wasm/pkg/ashwa_wasm.js",
    "wasm/pkg/ashwa_wasm_bg.wasm",
    "wasm/pkg/ashwa_wasm.d.ts",
    "wasm/pkg/ashwa_wasm_bg.wasm.d.ts",
    "wasm/pkg/package.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pid7-org/ashwa.git"
  },
  "bugs": {
    "url": "https://github.com/pid7-org/ashwa/issues"
  },
  "homepage": "https://github.com/pid7-org/ashwa#readme",
  "scripts": {
    "build:wasm": "cd wasm && RUSTFLAGS=\"-C target-feature=+simd128\" wasm-pack build --target web && rm -f pkg/.gitignore && echo '{\"type\":\"module\",\"private\":true}' > pkg/package.json",
    "build:native": "cd native && npx napi build --platform --release",
    "build": "npm run build:wasm && npm run build:native",
    "test": "npm run test:node && npm run test:wasm",
    "test:node": "node --test tests/node.test.js tests/node.test.mjs",
    "test:wasm": "node --test tests/wasm.test.js tests/wasm.test.mjs tests/browser.test.mjs",
    "bench": "npm run bench:node && npm run bench:wasm",
    "bench:node": "node benches/one_throughput.mjs",
    "bench:wasm": "node benches/wasm_throughput.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "playwright": "^1.50.0"
  },
  "license": "MIT OR Apache-2.0",
  "type": "commonjs",
  "keywords": [
    "simd",
    "simd128",
    "search",
    "string",
    "rust",
    "wasm",
    "napi-rs",
    "node"
  ]
}
