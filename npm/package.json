{
  "name": "@pid7/ashwa",
  "version": "0.1.1",
  "description": "Hardware accelerated routines for single substring search",
  "main": "./index.js",
  "module": "./browser.mjs",
  "types": "./index.d.ts",
  "browser": {
    "./index.js": "./browser.js",
    "./index.mjs": "./browser.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": {
        "import": "./browser.mjs",
        "require": "./browser.js"
      },
      "worker": {
        "import": "./browser.mjs",
        "require": "./browser.js"
      },
      "node": {
        "import": "./index.mjs",
        "require": "./index.js"
      },
      "import": "./browser.mjs",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pid7-org/ashwa.git"
  },
  "scripts": {
    "build:wasm": "cd wasm && RUSTFLAGS=\"-C target-feature=+simd128\" wasm-pack build --target web",
    "build:native": "cd native && npx @napi-rs/cli build --platform --release",
    "build": "npm run build:wasm && npm run build:native",
    "test": "node --test tests/node.test.js tests/node.test.mjs tests/wasm.test.js tests/wasm.test.mjs",
    "test:node": "node --test tests/node.test.js tests/node.test.mjs",
    "test:wasm": "node --test tests/wasm.test.js tests/wasm.test.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "license": "MIT OR Apache-2.0",
  "type": "commonjs",
  "keywords": [
    "simd",
    "simd128",
    "search",
    "string",
    "rust",
    "wasm",
    "napi-rs",
    "node"
  ]
}
