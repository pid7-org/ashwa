#!/usr/bin/env bash

# ==============================================================================
# bench-aws: Ephemeral AWS Benchmark Orchestrator for Ashwa (x86_64 & aarch64)
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TERRAFORM_DIR="${SCRIPT_DIR}"
RESULTS_DIR="${SCRIPT_DIR}/results"

AWS_PROFILE_ARG=""
REGION="us-east-1"
TARGET_ARCH="x86_64"
BENCH_TARGET=""
USER_INSTANCE_TYPE=""
USE_SPOT="true"
CPU_CORE=2
KEEP_ALIVE="false"

# Defaults strictly configured for 64 GiB DDR5 RAM and <= 16 vCPUs
DEFAULT_X86_INSTANCE="m7i.4xlarge"  # 16 vCPUs, 64 GiB DDR5 RAM (Intel Sapphire Rapids AVX-512BW)
DEFAULT_ARM_INSTANCE="m7g.4xlarge"  # 16 vCPUs, 64 GiB DDR5 RAM (AWS Graviton3 ARM NEON / SVE)

CURRENT_REF=""
if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    CURRENT_REF="$(git rev-parse HEAD 2>/dev/null || echo 'master')"
else
    CURRENT_REF="master"
fi

GIT_REF="$CURRENT_REF"

usage() {
    cat <<EOF
Usage: ./bench-aws [profile] [options]

Ephemeral AWS EC2 Spot benchmark orchestrator for Ashwa. Provisions dedicated
x86_64 and/or aarch64 instances (64 GiB DDR5 RAM, <= 16 vCPUs), executes hardware-accelerated
microarchitectural vector benchmarks (AVX-512BW / AVX2 / NEON) with CPU pinning,
collects artifacts, and automatically tears down cloud resources.

Arguments:
  profile                   AWS CLI profile name (default: \$AWS_PROFILE or 'default')

Benchmark Suite (REQUIRED - no default):
  -t, --target, --suite <t> Target suite to benchmark: 'one' or 'two'
      --one, -1             Benchmark single-byte search (search_one / one_throughput)
      --two, -2             Benchmark two-byte search (search_two / two_throughput)

Options:
  -a, --arch <arch>         Target architecture: 'x86_64', 'aarch64', or 'all'/'parallel' (default: x86_64)
      --aarch64, --arm64    Run benchmark on aarch64 (AWS Graviton3 with ARM NEON)
      --x86_64, --x64       Run benchmark on x86_64 (Intel Xeon Sapphire Rapids with AVX-512BW and DDR5)
      --parallel, --all     Run BOTH x86_64 and aarch64 benchmarks concurrently in parallel
  -i, --instance <type>     Override EC2 Instance Type:
                              - x86_64 default:  m7i.4xlarge (16 vCPUs, 64 GiB DDR5 RAM)
                              - aarch64 default: m7g.4xlarge (16 vCPUs, 64 GiB DDR5 RAM)
  -p, --profile <name>      AWS CLI profile name
  -r, --region <region>     AWS Region (default: us-east-1)
  -b, --ref <git-ref>       Git branch, tag, or commit hash (default: current HEAD '$CURRENT_REF')
  -c, --core <id>           CPU core to pin benchmark process to (default: 2)
  --on-demand               Use On-Demand instance instead of Spot instance
  --keep-alive              Do NOT destroy instance on exit (debug only)
  -h, --help                Show this help message
EOF
    exit 0
}

normalize_target() {
    case "${1,,}" in
        1|one|one_throughput|search_one) echo "one" ;;
        2|two|two_throughput|search_two) echo "two" ;;
        *) echo "" ;;
    esac
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            ;;
        -t|--target|--suite|--bench)
            BENCH_TARGET="$2"
            shift 2
            ;;
        --one|-1)
            BENCH_TARGET="one"
            shift
            ;;
        --two|-2)
            BENCH_TARGET="two"
            shift
            ;;
        -a|--arch|--architecture)
            TARGET_ARCH="$2"
            shift 2
            ;;
        --aarch64|--arm64)
            TARGET_ARCH="aarch64"
            shift
            ;;
        --x86_64|--x64|--amd64)
            TARGET_ARCH="x86_64"
            shift
            ;;
        --parallel|--all|--both)
            TARGET_ARCH="all"
            shift
            ;;
        -p|--profile)
            AWS_PROFILE_ARG="$2"
            shift 2
            ;;
        -r|--region)
            REGION="$2"
            shift 2
            ;;
        -i|--instance|--instance-type)
            USER_INSTANCE_TYPE="$2"
            shift 2
            ;;
        -b|--ref|--branch)
            GIT_REF="$2"
            shift 2
            ;;
        -c|--core)
            CPU_CORE="$2"
            shift 2
            ;;
        --on-demand)
            USE_SPOT="false"
            shift
            ;;
        --keep-alive)
            KEEP_ALIVE="true"
            shift
            ;;
        -*)
            echo "Unknown option: $1"
            usage
            ;;
        *)
            if [[ "$1" =~ ^(x86_64|x64|amd64|aarch64|arm64|all|both|parallel)$ ]]; then
                case "$1" in
                    x86_64|x64|amd64) TARGET_ARCH="x86_64" ;;
                    aarch64|arm64) TARGET_ARCH="aarch64" ;;
                    all|both|parallel) TARGET_ARCH="all" ;;
                esac
            elif [[ "$1" =~ ^(1|one|two|2|one_throughput|two_throughput|search_one|search_two)$ ]]; then
                BENCH_TARGET=$(normalize_target "$1")
            elif [ -z "$AWS_PROFILE_ARG" ]; then
                AWS_PROFILE_ARG="$1"
            fi
            shift
            ;;
    esac
done

if [ -n "$BENCH_TARGET" ]; then
    BENCH_TARGET=$(normalize_target "$BENCH_TARGET")
    if [ -z "$BENCH_TARGET" ]; then
        echo "Error: Invalid benchmark target. Choose 'one' or 'two'."
        exit 1
    fi
fi

if [ -z "$BENCH_TARGET" ]; then
    if [ -t 0 ]; then
        echo ""
        echo "================================================================================"
        echo "                       ASHWA BENCHMARK SUITE SELECTION                          "
        echo "================================================================================"
        echo " Please select the benchmark suite to run (no default):"
        echo ""
        echo "   1) one  - Single-byte search benchmark (search_one / one_throughput)"
        echo "   2) two  - Two-byte search benchmark (search_two / two_throughput)"
        echo ""
        read -rp " Select benchmark suite [1/2 or one/two]: " user_choice
        BENCH_TARGET=$(normalize_target "$user_choice")
        if [ -z "$BENCH_TARGET" ]; then
            echo "Error: Invalid selection '$user_choice'. Predefined options: 'one', 'two'."
            exit 1
        fi
        echo ""
    else
        echo "Error: Benchmark target is required (no default). Specify --target <one|two>, --one, or --two."
        exit 1
    fi
fi

RESULTS_DIR="${SCRIPT_DIR}/results/${BENCH_TARGET}"

# Normalize and resolve git ref
if [ "${GIT_REF,,}" = "head" ]; then
    GIT_REF="HEAD"
fi

if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    RESOLVED_REF="$(git rev-parse "$GIT_REF" 2>/dev/null || true)"
    if [ -n "$RESOLVED_REF" ]; then
        GIT_REF="$RESOLVED_REF"
    fi
fi

get_available_profiles() {
    {
        grep -E '^\s*\[profile ' ~/.aws/config 2>/dev/null | sed -E 's/^\s*\[profile\s+([^]]+)\]/\1/' || true
        grep -E '^\s*\[[a-zA-Z0-9_-]+\]' ~/.aws/credentials 2>/dev/null | tr -d '[] \t' || true
        grep -E '^\s*\[default\]' ~/.aws/config 2>/dev/null | tr -d '[] \t' || true
    } | sort -u
}

AVAILABLE_PROFILES=$(get_available_profiles | tr '\n' ' ' || true)
EFFECTIVE_PROFILE=""

if [ -n "$AWS_PROFILE_ARG" ]; then
    PROFILE_FOUND=false
    for p in $AVAILABLE_PROFILES; do
        if [ "$p" = "$AWS_PROFILE_ARG" ]; then
            PROFILE_FOUND=true
            break
        fi
    done

    if [ "$PROFILE_FOUND" = "false" ] && [ -n "$AVAILABLE_PROFILES" ]; then
        echo "Error: AWS profile '$AWS_PROFILE_ARG' not found. Available profile(s): $AVAILABLE_PROFILES"
        exit 1
    fi

    EFFECTIVE_PROFILE="$AWS_PROFILE_ARG"
elif [ -n "${AWS_PROFILE:-}" ]; then
    EFFECTIVE_PROFILE="$AWS_PROFILE"
elif [ -n "${AWS_ACCESS_KEY_ID:-}" ]; then
    EFFECTIVE_PROFILE=""
else
    for p in $AVAILABLE_PROFILES; do
        if [ "$p" = "default" ]; then
            EFFECTIVE_PROFILE="default"
            break
        fi
    done
fi

[ -n "$EFFECTIVE_PROFILE" ] && export AWS_PROFILE="$EFFECTIVE_PROFILE"

for tool in terraform ssh scp git; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "Error: Required dependency '$tool' not found in PATH."
        exit 1
    fi
done

# Architecture resolution
declare -a EXEC_ARCHES=()
case "$TARGET_ARCH" in
    x86_64|x64|amd64)
        EXEC_ARCHES=("x86_64")
        ;;
    aarch64|arm64)
        EXEC_ARCHES=("aarch64")
        ;;
    all|both|parallel)
        EXEC_ARCHES=("x86_64" "aarch64")
        ;;
    *)
        echo "Error: Invalid architecture '$TARGET_ARCH'. Choose 'x86_64', 'aarch64', or 'all'."
        exit 1
        ;;
esac

get_instance_type_for_arch() {
    local arch="$1"
    if [ -n "$USER_INSTANCE_TYPE" ]; then
        echo "$USER_INSTANCE_TYPE"
    elif [ "$arch" = "aarch64" ] || [ "$arch" = "arm64" ]; then
        echo "$DEFAULT_ARM_INSTANCE"
    else
        echo "$DEFAULT_X86_INSTANCE"
    fi
}

# NOTE: Ephemeral teardown trap guarantees cloud destruction across all provisioned architectures
cleanup() {
    local exit_code=$?
    trap - EXIT INT TERM

    if [ "$KEEP_ALIVE" = "true" ]; then
        echo ""
        echo "[!] --keep-alive specified. Retaining instance(s) for post-mortem debugging."
        return $exit_code
    fi

    echo ""
    echo "--------------------------------------------------------------------------------"
    echo "  [TEARDOWN] Destroying ephemeral cloud infrastructure...                       "
    echo "--------------------------------------------------------------------------------"

    cd "$TERRAFORM_DIR"
    for arch in "${EXEC_ARCHES[@]}"; do
        local state_file="${TERRAFORM_DIR}/terraform_${arch}.tfstate"
        local inst_type
        inst_type=$(get_instance_type_for_arch "$arch")

        if [ -f "$state_file" ]; then
            echo "  [TEARDOWN] Destroying $arch runner ($inst_type)..."
            local tf_destroy_args=(
                "-state=$state_file"
                "-var=arch=$arch"
                "-var=aws_region=$REGION"
                "-var=instance_type=$inst_type"
                "-var=use_spot=$USE_SPOT"
                "-var=git_ref=$GIT_REF"
                "-var=cpu_core=$CPU_CORE"
                "-var=ssh_key_path=${TERRAFORM_DIR}/id_ed25519_${arch}"
            )
            [ -n "$EFFECTIVE_PROFILE" ] && tf_destroy_args+=("-var=aws_profile=$EFFECTIVE_PROFILE")
            terraform destroy -auto-approve "${tf_destroy_args[@]}" >/dev/null 2>&1 || true
            rm -f "$state_file" "${state_file}.backup" "${TERRAFORM_DIR}/id_ed25519_${arch}"
        fi
    done

    # Cleanup default state/key if present
    if [ -f "${TERRAFORM_DIR}/terraform.tfstate" ] && [ -s "${TERRAFORM_DIR}/terraform.tfstate" ]; then
        terraform destroy -auto-approve >/dev/null 2>&1 || true
        rm -f "${TERRAFORM_DIR}/id_ed25519" "${TERRAFORM_DIR}/id_ed25519.pub"
    fi

    echo "  [TEARDOWN] Cleanup complete."
    return $exit_code
}

trap cleanup EXIT INT TERM

run_single_benchmark() {
    local arch="$1"
    local inst_type
    inst_type=$(get_instance_type_for_arch "$arch")
    local state_file="${TERRAFORM_DIR}/terraform_${arch}.tfstate"
    local ssh_key="${TERRAFORM_DIR}/id_ed25519_${arch}"
    local arch_results_dir="${RESULTS_DIR}/${arch}"
    local log_prefix="[$arch]"
    local toolchain_type="stable"
    if [ "$arch" = "x86_64" ] || [ "$arch" = "amd64" ] || [ "$arch" = "x64" ]; then
        toolchain_type="nightly"
    fi

    log() {
        echo "$log_prefix $*"
    }

    log "[1/5] Provisioning cloud runner ($arch on $inst_type, Region: $REGION, Spot: $USE_SPOT)..."

    local tf_args=(
        "-state=$state_file"
        "-var=arch=$arch"
        "-var=aws_region=$REGION"
        "-var=instance_type=$inst_type"
        "-var=use_spot=$USE_SPOT"
        "-var=git_ref=$GIT_REF"
        "-var=cpu_core=$CPU_CORE"
        "-var=ssh_key_path=$ssh_key"
    )
    [ -n "$EFFECTIVE_PROFILE" ] && tf_args+=("-var=aws_profile=$EFFECTIVE_PROFILE")

    cd "$TERRAFORM_DIR"
    terraform apply -auto-approve "${tf_args[@]}" >/dev/null

    local public_ip
    public_ip=$(terraform output -state="$state_file" -raw public_ip)

    chmod 600 "$ssh_key"
    local ssh_opts="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=30 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 -o TCPKeepAlive=yes -i $ssh_key"

    log "[2/5] Polling SSH connectivity on $public_ip..."
    local max_retries=60
    local retry_count=0
    local consecutive_success=0

    while [ $consecutive_success -lt 2 ]; do
        if ssh $ssh_opts "ubuntu@$public_ip" "true" >/dev/null 2>&1; then
            consecutive_success=$((consecutive_success + 1))
            sleep 1
        else
            consecutive_success=0
            retry_count=$((retry_count + 1))
            if [ $retry_count -ge $max_retries ]; then
                log "Error: Timed out waiting for SSH on $public_ip"
                return 1
            fi
            sleep 2
        fi
    done
    log "Connected via SSH!"

    read -r -d '' BOOTSTRAP_SCRIPT << 'REMOTE_BOOTSTRAP' || true
set -euo pipefail
TARGET_REF="$1"
TOOLCHAIN_TYPE="${2:-stable}"
export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a
export NEEDRESTART_SUSPEND=1

sudo sed -i 's/#\$nrconf{restart} = .*/\$nrconf{restart} = "a";/' /etc/needrestart/needrestart.conf 2>/dev/null || true
sudo systemctl stop unattended-upgrades.service 2>/dev/null || true
sudo systemctl disable unattended-upgrades.service 2>/dev/null || true
sudo killall -9 apt-get apt unattended-upgrade 2>/dev/null || true

while sudo fuser /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/lib/dpkg/lock >/dev/null 2>&1; do
    sleep 1
done

sudo apt-get update -y -qq >/dev/null 2>&1
sudo apt-get install -y -qq -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" build-essential gcc git curl pkg-config python3 python3-dev python3-pip linux-tools-common linux-tools-generic "linux-tools-$(uname -r)" >/dev/null 2>&1 || \
    sudo apt-get install -y -qq -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" build-essential gcc git curl pkg-config python3 python3-dev python3-pip >/dev/null 2>&1

if ! command -v node >/dev/null 2>&1; then
    curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash - >/dev/null 2>&1 || true
    sudo apt-get install -y -qq nodejs >/dev/null 2>&1 || true
fi

if [ ! -f "$HOME/.cargo/env" ]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain "$TOOLCHAIN_TYPE" --profile minimal -q >/dev/null 2>&1
fi
# shellcheck source=/dev/null
source "$HOME/.cargo/env"
rustup default "$TOOLCHAIN_TYPE" >/dev/null 2>&1 || true

if ! command -v wasm-pack >/dev/null 2>&1; then
    curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh -s -- -y >/dev/null 2>&1 || true
fi

git config --global advice.detachedHead false
rm -rf "$HOME/ashwa"
git clone -q "https://github.com/pid7-org/ashwa.git" "$HOME/ashwa"
cd "$HOME/ashwa"
if [ "${TARGET_REF,,}" = "head" ]; then
    TARGET_REF="HEAD"
fi
git checkout --quiet "$TARGET_REF" || git checkout --quiet "origin/$TARGET_REF" || true

if [ -d "$HOME/ashwa/npm" ]; then
    cd "$HOME/ashwa/npm"
    npm install --ignore-scripts >/dev/null 2>&1 || true
    if command -v wasm-pack >/dev/null 2>&1; then
        npm run build:wasm >/dev/null 2>&1 || true
    fi
    cd "$HOME/ashwa"
fi

if [ -d "$HOME/ashwa/pypi" ]; then
    cd "$HOME/ashwa/pypi"
    cd "$HOME/ashwa"
fi
REMOTE_BOOTSTRAP

    log "[3/5] Bootstrapping host environment ($toolchain_type toolchain)..."
    local bootstrap_retries=3
    local bootstrap_count=0
    until ssh $ssh_opts "ubuntu@$public_ip" bash -s -- "$GIT_REF" "$toolchain_type" <<< "$BOOTSTRAP_SCRIPT"; do
        bootstrap_count=$((bootstrap_count + 1))
        if [ $bootstrap_count -ge $bootstrap_retries ]; then
            log "Error: Bootstrap failed after $bootstrap_retries attempts."
            return 1
        fi
        log "SSH connection dropped during bootstrap, retrying in 3s ($bootstrap_count/$bootstrap_retries)..."
        sleep 3
    done

    log "Uploading benchmark scripts to remote node..."
    scp -r $ssh_opts "${TERRAFORM_DIR}/scripts" "ubuntu@$public_ip:/home/ubuntu/" >/dev/null
    ssh $ssh_opts "ubuntu@$public_ip" "chmod +x /home/ubuntu/scripts/run_benchmarks.sh"

    log "[4/5] Executing benchmark suite ($BENCH_TARGET) on remote runner (Core $CPU_CORE)..."
    ssh $ssh_opts "ubuntu@$public_ip" "BENCH_TARGET=$BENCH_TARGET CPU_CORE=$CPU_CORE /home/ubuntu/scripts/run_benchmarks.sh"

    log "[5/5] Fetching results and teardown..."
    mkdir -p "$arch_results_dir"
    scp -r $ssh_opts "ubuntu@$public_ip:/home/ubuntu/results/${BENCH_TARGET}/*" "$arch_results_dir/" >/dev/null 2>&1 || \
    scp -r $ssh_opts "ubuntu@$public_ip:/home/ubuntu/results/*" "$arch_results_dir/" >/dev/null 2>&1 || true

    # Backwards compatibility: copy to root results dir if single run
    if [ "${#EXEC_ARCHES[@]}" -eq 1 ]; then
        cp -rf "$arch_results_dir"/* "$RESULTS_DIR/" 2>/dev/null || true
    fi

    log "Benchmark complete. Results archived to $arch_results_dir"

    if [ "$KEEP_ALIVE" != "true" ]; then
        log "Tearing down $arch ephemeral instance..."
        terraform destroy -auto-approve "${tf_args[@]}" >/dev/null 2>&1 || true
        rm -f "$state_file" "${state_file}.backup" "$ssh_key"
    fi
}

echo "--------------------------------------------------------------------------------"
echo "                     ASHWA AWS BENCHMARK ORCHESTRATOR                           "
echo "--------------------------------------------------------------------------------"
echo " Profile:       ${EFFECTIVE_PROFILE:-<environment credentials>}"
echo " Region:        $REGION"
echo " Target Suite:  $BENCH_TARGET ($([ "$BENCH_TARGET" = "one" ] && echo "Single-Byte search_one" || echo "Two-Byte search_two"))"
echo " Target Arch:   ${EXEC_ARCHES[*]}"
if [ "${#EXEC_ARCHES[@]}" -eq 1 ]; then
    echo " Instance Type: $(get_instance_type_for_arch "${EXEC_ARCHES[0]}") (64 GiB RAM, 16 vCPUs)"
else
    echo " Instances:     x86_64: $DEFAULT_X86_INSTANCE (Intel Xeon Sapphire Rapids, 16 vCPUs, 64 GiB DDR5 RAM)"
    echo "                aarch64: $DEFAULT_ARM_INSTANCE (AWS Graviton3 Neoverse-V1, 16 vCPUs, 64 GiB DDR5 RAM)"
    echo " Mode:          PARALLEL CONCURRENT EXECUTION"
fi
echo " Lifecycle:     $([ "$USE_SPOT" = "true" ] && echo "Spot" || echo "On-Demand")"
echo " Git Ref:       $GIT_REF"
echo " Pinned Core:   CPU $CPU_CORE"
echo "--------------------------------------------------------------------------------"
echo ""

mkdir -p "$RESULTS_DIR"
cd "$TERRAFORM_DIR"
terraform init -input=false >/dev/null

if [ "${#EXEC_ARCHES[@]}" -eq 1 ]; then
    run_single_benchmark "${EXEC_ARCHES[0]}"
else
    echo "--------------------------------------------------------------------------------"
    echo "  [PARALLEL] Launching concurrent benchmarks on x86_64 and aarch64...           "
    echo "--------------------------------------------------------------------------------"
    
    PIDS=()
    for arch in "${EXEC_ARCHES[@]}"; do
        (
            run_single_benchmark "$arch" 2>&1 | tee "${RESULTS_DIR}/bench-${arch}.log"
        ) &
        PIDS+=($!)
    done

    FAILED=0
    for pid in "${PIDS[@]}"; do
        wait "$pid" || FAILED=1
    done

    if [ "$FAILED" -ne 0 ]; then
        echo ""
        echo "Error: One or more parallel benchmark jobs encountered failures."
        exit 1
    fi
fi

echo ""
echo "--------------------------------------------------------------------------------"
echo "                             BENCHMARK SUMMARY REPORTS                          "
echo "--------------------------------------------------------------------------------"

for arch in "${EXEC_ARCHES[@]}"; do
    arch_summary="${RESULTS_DIR}/${arch}/summary.txt"
    if [ -f "$arch_summary" ]; then
        echo ""
        echo "========================= ARCHITECTURE: $arch ========================="
        cat "$arch_summary"
        echo "=========================================================================="
    fi
done

echo ""
echo "All benchmarks finished successfully. Artifacts available in: $RESULTS_DIR"

