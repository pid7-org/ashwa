#!/usr/bin/env bash

# ==============================================================================
# bench-aws: Ephemeral AWS Benchmark Orchestrator for Ashwa
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TERRAFORM_DIR="${SCRIPT_DIR}"
RESULTS_DIR="${SCRIPT_DIR}/results"

AWS_PROFILE_ARG=""
REGION="us-east-1"
INSTANCE_TYPE="c6i.2xlarge"
USE_SPOT="true"
CPU_CORE=2
KEEP_ALIVE="false"

CURRENT_REF=""
if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    CURRENT_REF="$(git rev-parse HEAD 2>/dev/null || echo 'master')"
else
    CURRENT_REF="master"
fi

GIT_REF="$CURRENT_REF"

usage() {
    cat <<EOF
Usage: ./bench-aws [profile] [options]

Ephemeral AWS EC2 Spot benchmark orchestrator for Ashwa. Provisions a dedicated instance,
executes microarchitectural vector benchmarks on the highest available ISA with pinned CPU cores,
collects artifacts, and tears down cloud resources automatically.

Arguments:
  profile                   AWS CLI profile name (default: \$AWS_PROFILE or 'default')

Options:
  -p, --profile <name>      AWS CLI profile name
  -r, --region <region>     AWS Region (default: us-east-1)
  -i, --instance <type>     EC2 Instance Type (default: c6i.2xlarge - Ice Lake with AVX-512BW)
  -b, --ref <git-ref>       Git branch, tag, or commit hash (default: current HEAD '$CURRENT_REF')
  -c, --core <id>           CPU core to pin benchmark process to (default: 2)
  --on-demand               Use On-Demand instance instead of Spot instance
  --keep-alive              Do NOT destroy instance on exit (debug only)
  -h, --help                Show this help message
EOF
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            ;;
        -p|--profile)
            AWS_PROFILE_ARG="$2"
            shift 2
            ;;
        -r|--region)
            REGION="$2"
            shift 2
            ;;
        -i|--instance|--instance-type)
            INSTANCE_TYPE="$2"
            shift 2
            ;;
        -b|--ref|--branch)
            GIT_REF="$2"
            shift 2
            ;;
        -c|--core)
            CPU_CORE="$2"
            shift 2
            ;;
        --on-demand)
            USE_SPOT="false"
            shift
            ;;
        --keep-alive)
            KEEP_ALIVE="true"
            shift
            ;;
        -*)
            echo "Unknown option: $1"
            usage
            ;;
        *)
            if [ -z "$AWS_PROFILE_ARG" ]; then
                AWS_PROFILE_ARG="$1"
            fi
            shift
            ;;
    esac
done

get_available_profiles() {
    {
        grep -E '^\s*\[profile ' ~/.aws/config 2>/dev/null | sed -E 's/^\s*\[profile\s+([^]]+)\]/\1/' || true
        grep -E '^\s*\[[a-zA-Z0-9_-]+\]' ~/.aws/credentials 2>/dev/null | tr -d '[] \t' || true
        grep -E '^\s*\[default\]' ~/.aws/config 2>/dev/null | tr -d '[] \t' || true
    } | sort -u
}

AVAILABLE_PROFILES=$(get_available_profiles | tr '\n' ' ' || true)
EFFECTIVE_PROFILE=""

if [ -n "$AWS_PROFILE_ARG" ]; then
    PROFILE_FOUND=false
    for p in $AVAILABLE_PROFILES; do
        if [ "$p" = "$AWS_PROFILE_ARG" ]; then
            PROFILE_FOUND=true
            break
        fi
    done

    if [ "$PROFILE_FOUND" = "false" ] && [ -n "$AVAILABLE_PROFILES" ]; then
        echo "Error: AWS profile '$AWS_PROFILE_ARG' not found. Available profile(s): $AVAILABLE_PROFILES"
        exit 1
    fi

    EFFECTIVE_PROFILE="$AWS_PROFILE_ARG"
elif [ -n "${AWS_PROFILE:-}" ]; then
    EFFECTIVE_PROFILE="$AWS_PROFILE"
elif [ -n "${AWS_ACCESS_KEY_ID:-}" ]; then
    EFFECTIVE_PROFILE=""
else
    for p in $AVAILABLE_PROFILES; do
        if [ "$p" = "default" ]; then
            EFFECTIVE_PROFILE="default"
            break
        fi
    done
fi

[ -n "$EFFECTIVE_PROFILE" ] && export AWS_PROFILE="$EFFECTIVE_PROFILE"

TF_VAR_ARGS=(
    "-var=aws_region=$REGION"
    "-var=instance_type=$INSTANCE_TYPE"
    "-var=use_spot=$USE_SPOT"
    "-var=git_ref=$GIT_REF"
    "-var=cpu_core=$CPU_CORE"
)
[ -n "$EFFECTIVE_PROFILE" ] && TF_VAR_ARGS+=("-var=aws_profile=$EFFECTIVE_PROFILE")

for tool in terraform ssh scp git; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "Error: Required dependency '$tool' not found in PATH."
        exit 1
    fi
done

# NOTE: Ephemeral teardown trap guarantees cloud destruction even on SIGINT/SIGTERM
cleanup() {
    local exit_code=$?
    if [ "$KEEP_ALIVE" = "true" ]; then
        echo ""
        echo "[!] --keep-alive specified. Retaining instance for post-mortem debugging."
        return $exit_code
    fi

    echo ""
    echo "================================================================================"
    echo "  [TEARDOWN] Destroying ephemeral cloud infrastructure...                       "
    echo "================================================================================"
    
    cd "$TERRAFORM_DIR"
    terraform destroy -auto-approve "${TF_VAR_ARGS[@]}" || true
    
    rm -f id_ed25519 id_ed25519.pub
    echo "  [TEARDOWN] Cleanup complete."
    
    return $exit_code
}

trap cleanup EXIT INT TERM

echo "================================================================================"
echo "                     ASHWA AWS BENCHMARK ORCHESTRATOR                           "
echo "================================================================================"
echo " Profile:       ${EFFECTIVE_PROFILE:-<environment credentials>}"
echo " Region:        $REGION"
echo " Instance Type: $INSTANCE_TYPE"
echo " Lifecycle:     $([ "$USE_SPOT" = "true" ] && echo "Spot" || echo "On-Demand")"
echo " Git Ref:       $GIT_REF"
echo " Pinned Core:   CPU $CPU_CORE"
echo "================================================================================"
echo ""

cd "$TERRAFORM_DIR"
terraform init -input=false
terraform apply -auto-approve "${TF_VAR_ARGS[@]}"

PUBLIC_IP=$(terraform output -raw public_ip)
SSH_KEY="${TERRAFORM_DIR}/id_ed25519"

chmod 600 "$SSH_KEY"
SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 -o ServerAliveInterval=10 -i $SSH_KEY"

echo "Provisioned instance: $PUBLIC_IP. Polling SSH readiness..."
max_retries=60
retry_count=0

until ssh $SSH_OPTS "ubuntu@$PUBLIC_IP" "true" >/dev/null 2>&1; do
    retry_count=$((retry_count + 1))
    if [ $retry_count -ge $max_retries ]; then
        echo "Error: Timed out waiting for SSH on $PUBLIC_IP"
        exit 1
    fi

    echo -n "."
    sleep 2
done
echo " Connected!"

# NOTE: Bootstrap provisioned host with Linux PMU tools and Rust nightly (required for AVX-512 intrinsics)
ssh $SSH_OPTS "ubuntu@$PUBLIC_IP" bash -s -- "$GIT_REF" << 'REMOTE_BOOTSTRAP'
set -euo pipefail
TARGET_REF="$1"
export DEBIAN_FRONTEND=noninteractive

sudo systemctl stop unattended-upgrades.service 2>/dev/null || true
sudo systemctl disable unattended-upgrades.service 2>/dev/null || true
sudo killall -9 apt-get apt unattended-upgrade 2>/dev/null || true

while sudo fuser /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/lib/dpkg/lock >/dev/null 2>&1; do
    sleep 1
done

sudo apt-get update -y -qq
sudo apt-get install -y -qq build-essential gcc git curl pkg-config linux-tools-common linux-tools-generic "linux-tools-$(uname -r)" || \
    sudo apt-get install -y -qq build-essential gcc git curl pkg-config

if [ ! -f "$HOME/.cargo/env" ]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain nightly --profile minimal -q
fi
# shellcheck source=/dev/null
source "$HOME/.cargo/env"
rustup default nightly 2>/dev/null || true

rm -rf "$HOME/ashwa"
git clone -q "https://github.com/pid7-org/ashwa.git" "$HOME/ashwa"
cd "$HOME/ashwa"
git checkout "$TARGET_REF"
REMOTE_BOOTSTRAP

# NOTE: Sync benchmark scripts to instance
scp -r $SSH_OPTS "${TERRAFORM_DIR}/scripts" "ubuntu@$PUBLIC_IP:/home/ubuntu/"
ssh $SSH_OPTS "ubuntu@$PUBLIC_IP" "chmod +x /home/ubuntu/scripts/run_benchmarks.sh"

echo "================================================================================"
echo "  [BENCHMARK] Executing suite on remote node...                                 "
echo "================================================================================"
ssh $SSH_OPTS "ubuntu@$PUBLIC_IP" "CPU_CORE=$CPU_CORE /home/ubuntu/scripts/run_benchmarks.sh"

mkdir -p "$RESULTS_DIR"
scp -r $SSH_OPTS "ubuntu@$PUBLIC_IP:/home/ubuntu/results/*" "$RESULTS_DIR/" 2>/dev/null || true

if [ -f "${RESULTS_DIR}/summary.txt" ]; then
    echo ""
    echo "============================= BENCHMARK SUMMARY ============================="
    cat "${RESULTS_DIR}/summary.txt"
    echo "============================================================================="
fi
